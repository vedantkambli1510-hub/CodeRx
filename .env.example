# ==============================================================================
# CodeRx Environment Configuration (.env.example)
# Turn Medical Records Into One Clear Patient Story
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Public application URL used for OAuth redirects, webhooks, and emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Secret string used to sign session cookies and JWT tokens (min 32 characters)
SESSION_SECRET="coderx-super-secure-production-secret-token-change-in-prod-xyz789"

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Local Development SQLite default:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example (Supabase / AWS RDS / Neon):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. CODERX AI CLINICAL ENGINE (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 5. PRIVATE MEDICAL FILE STORAGE
# ------------------------------------------------------------------------------
# Local private storage directory (default, automatically created)
LOCAL_STORAGE_PATH="./storage/medical_records"

# S3 / Supabase Storage credentials (for production cloud object storage):
# S3_ENDPOINT="https://[project-id].supabase.co/storage/v1/s3"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-s3-access-key"
# S3_SECRET_ACCESS_KEY="your-s3-secret-key"
# S3_BUCKET_NAME="coderx-medical-records"

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay - India / Stripe)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL ENGINE (Resend / AWS SES)
# ------------------------------------------------------------------------------
# Obtain from Resend: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="CodeRx Medical <prescriptions@coderx.health>"

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP NOTIFICATIONS (Twilio / Meta WhatsApp Business)
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token (optional, for SMS delivery):
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# WhatsApp Business API token (optional):
WHATSAPP_API_TOKEN="your_whatsapp_bearer_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
